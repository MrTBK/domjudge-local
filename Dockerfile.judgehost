FROM domjudge/judgehost:9.0.1

ENV DEBIAN_FRONTEND=noninteractive

# Install additional compilers and runtimes in the outer container
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        pypy3 \
        rustc \
        golang-go \
        nodejs \
        mono-mcs \
        mono-runtime \
        kotlin && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install additional compilers and runtimes inside execution chroot (/chroot/domjudge)
RUN cp /etc/resolv.conf /chroot/domjudge/etc/resolv.conf && \
    chroot /chroot/domjudge apt-get update && \
    chroot /chroot/domjudge apt-get install -y --no-install-recommends \
        pypy3 \
        rustc \
        golang-go \
        nodejs \
        mono-mcs \
        mono-runtime \
        kotlin && \
    echo '/usr/lib/jvm/java-21-openjdk-amd64/lib' > /chroot/domjudge/etc/ld.so.conf.d/java.conf && \
    mkdir -p /chroot/domjudge/usr/share/kotlin/kotlinc && \
    echo '1.3.31' > /chroot/domjudge/usr/share/kotlin/kotlinc/build.txt && \
    printf '#!/bin/sh\nexport GOROOT=/usr/lib/go-1.22\nexec /usr/bin/go "$@"\n' > /chroot/domjudge/usr/local/bin/go && \
    chmod +x /chroot/domjudge/usr/local/bin/go && \
    chroot /chroot/domjudge ldconfig && \
    chroot /chroot/domjudge apt-get clean && \
    rm -rf /chroot/domjudge/var/lib/apt/lists/*
